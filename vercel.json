{
  "rewrites": [
    {
      "source": "/sb/:path*",
      "destination": "https://lwanymjmbcstvggmhevx.supabase.co/:path*"
    },
    {
      "source": "/i/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/create/:path*",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/i/anna-maksim-umj8s",
      "destination": "/i/katya-nastya",
      "permanent": true
    },
    {
      "source": "/i/katya-nastya-umj8s",
      "destination": "/i/katya-nastya",
      "permanent": true
    }
  ],
  "buildCommand": "node scripts/build.cjs",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "outputDirectory": "public",
  "functions": {
    "api/startup-assets.js": {
      "includeFiles": "{supabase.min.js,assets/invella-bundle.css,assets/invella-app.js,assets/invella-premium-fix.js}"
    }
  }
}
